{
  "name": "herdr-workspace",
  "version": "0.1.0-beta.1",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/koraybostanci/herdr-workspace.git"
  },
  "type": "module",
  "description": "Installable Herdr workspace: Agents tree, searchable History and session tabs.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "node --test tests/",
    "test:clean-install": "node scripts/test-clean-install.mjs",
    "test:native-install": "node scripts/test-native-install.mjs",
    "release:build": "node scripts/build-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:private": "node scripts/publish-private-beta.mjs",
    "check:privacy": "node scripts/check-private-content.mjs --tracked-and-untracked-allowlist"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  },
  "bin": {
    "herdr-workspace": "bin/herdr-workspace.mjs"
  }
}
