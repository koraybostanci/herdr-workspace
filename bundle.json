          "main.js"
        ]
      },
      {
        "name": "menu",
        "files": [
          "mod.json",
          "main.js"
        ]
      },
      {
        "name": "new-menu",
        "files": [
          "mod.json",
          "main.js"
        ]
      },
      {
        "name": "picker",
        "files": [
          "mod.json",
          "main.js"
        ]
      }
