      "mods/workspace-chrome/server.svg",
      "mods/workspace-chrome/spinner.svg",
      "mods/workspace-chrome/terminal.svg"
    ],
    "assetPatterns": [
      "mods/workspace-chrome/*.svg",
      "mods/workspace-chrome/chevron-*.svg"
    ]
  },
  "parity": [
    [
      "integrations/session-metadata/src/session-registry.mjs",
      "mods/space-agents/session-registry.js"
    ],
    [
