      },
      {
        "name": "pane",
        "files": [
          "mod.json",
          "main.js"
        ]
      },
      {
        "name": "menu",
        "files": [
          "mod.json",
          "main.js"
        ]
      },
      {
        "name": "new-menu",
        "files": [
          "mod.json",
          "main.js"
        ]
      }
    ],
    "assets": [
      "mods/changes/changes.svg",
      "mods/files/file.svg",
      "mods/pane/close.svg",
      "mods/workspace-chrome/branch.svg",
      "mods/workspace-chrome/check.svg",
      "mods/workspace-chrome/chevron-down.svg",
      "mods/workspace-chrome/chevron-right.svg",
      "mods/workspace-chrome/layers.svg",
      "mods/workspace-chrome/monitor.svg",
