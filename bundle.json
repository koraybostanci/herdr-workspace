      "mods/workspace-chrome/spinner.svg",
      "mods/workspace-chrome/terminal.svg"
    ],
    "assetPatterns": [
      "mods/workspace-chrome/*.svg",
      "mods/workspace-chrome/chevron-*.svg"
    ]
  },
