      "darwin"
    ]
  },
  "include": [
    "layouts/herdr-workspace.json",
    "mods/compact-spaces",
    "mods/workspace-header",
    "mods/session-tabs",
    "mods/space-agents",
    "integrations/session-metadata/.npmrc",
    "integrations/session-metadata/package.json",
