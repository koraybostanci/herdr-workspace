    {
      "name": "space-agents"
    },
    {
      "name": "compact-spaces"
    },
    {
      "name": "session-tabs"
    }
  ],
  "helper": {
    "root": "integrations/session-metadata",
    "entries": [
      "integrations/session-metadata/bin/herdr-session-meta.mjs"
    ],
    "manifests": [
      "integrations/session-metadata/package.json",
      "integrations/session-metadata/package-lock.json"
    ]
  },
  "runtimeDependencies": [
    "@anthropic-ai/claude-agent-sdk",
    "jsonc-parser"
  ],
  "harnessModules": [
    "@opencode/plugin/tui",
    "solid-js"
  ],
  "host": {
    "version": "0.1.9",
    "mods": [
      {
        "name": "workspace-chrome",
        "files": [
          "mod.json",
          "main.js"
        ]
      },
      {
        "name": "workspace-status",
