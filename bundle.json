{
  "schema": 1,
  "owner": "herdr-workspace",
  "version": "0.1.0",
  "requires": {
    "node": ">=26",
    "nodeBuiltins": [],
    "herdr": "0.1.9",
    "platforms": [
      "darwin"
    ]
  },
  "include": [
    "layouts/herdr-workspace.json",
    "mods/compact-spaces",
    "mods/session-tabs",
    "mods/space-agents",
    "integrations/session-metadata/.npmrc",
    "integrations/session-metadata/package.json",
    "integrations/session-metadata/package-lock.json",
    "integrations/session-metadata/bin",
    "integrations/session-metadata/src",
    "integrations/session-metadata/claude",
    "integrations/session-metadata/opencode"
  ],
  "installer": [
    "bin",
    "src",
    "package.json",
    "package-lock.json",
    ".npmrc"
  ],
  "layout": {
    "name": "herdr-workspace",
    "path": "layouts/herdr-workspace.json"
  },
