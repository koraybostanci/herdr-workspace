      "integrations/session-metadata/package.json",
      "integrations/session-metadata/package-lock.json"
    ]
  },
  "runtimeDependencies": [
    "@anthropic-ai/claude-agent-sdk",
    "jsonc-parser"
  ],
  "harnessModules": [
    "@opencode/plugin/tui",
    "solid-js"
  ],
