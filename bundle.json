{
  "schema": 1,
  "owner": "herdr-workspace",
  "version": "0.1.0",
  "requires": {
    "node": ">=26",
    "nodeBuiltins": [],
    "herdr": "0.1.9",
    "platforms": [
      "darwin"
    ]
  },
  "include": [
    "layouts/herdr-workspace.json",
    "mods/compact-spaces",
    "mods/workspace-header",
    "mods/session-tabs",
    "mods/space-agents",
    "integrations/session-metadata/.npmrc",
